APP_NAME=CRM-StarterKit
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080

DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=starterkit
DB_USER=postgres
DB_PASSWORD=secret
DB_SSLMODE=disable
DB_TIMEZONE=UTC
DB_SQLITE_PATH=./storage/database.sqlite

CACHE_DRIVER=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
MEMCACHED_HOST=localhost:11211
CACHE_PREFIX=crm:
CACHE_DEFAULT_TTL=1h

JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_ISSUER=crm-starterkit

CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Origin,Content-Type,Accept,Authorization
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=86400

RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1m

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:8080/uploads

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
AWS_S3_PUBLIC_BASE_URL=

LOG_LEVEL=info
LOG_ENCODING=json

WORKER_CONCURRENCY=10
QUEUE_REDIS_ADDR=localhost:6379
QUEUE_REDIS_PASSWORD=
QUEUE_REDIS_DB=1

MIGRATIONS_PATH=./migrations

PAYMENT_CALLBACK_BASE_URL=http://localhost:8080/api/v1/payments/callback
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

SMS_PROVIDER=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
